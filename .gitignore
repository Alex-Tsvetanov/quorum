# --- LaTeX ------------------------------------------------------------------
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# docs/build/ се игнорира ЦЯЛА с изключение на готовия PDF: той е крайният
# резултат, предава се, затова се версионира заедно с източника си.
# (git не поддържа коментар СЛЕД шаблон на същия ред, затова са отделни редове)
docs/build/*
!docs/build/Main.pdf

# Генерирани от инструменти таблици и фигури, възстановяват се от измерванията.
# Двата заместващи файла обаче се версионират: preamble.tex ги зарежда
# безусловно и без тях компилацията спира при чисто клониране.
docs/generated/*
!docs/generated/board_macros.tex
!docs/generated/gif_frames.tex

# --- C++ / CMake ------------------------------------------------------------
# Закотвено в корена. Незакотвеното `build/` би съвпаднало и с docs/build и би
# обезсилило изключението за Main.pdf по-горе: git не може да върне обратно файл,
# чиято родителска ПАПКА е изключена.
/build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
_deps/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk

# --- Резултати от измервания ------------------------------------------------
results/
*.csv.tmp

# --- Среди за разработка ----------------------------------------------------
.vscode/
.idea/
.cache/
*.swp
.DS_Store
Thumbs.db
